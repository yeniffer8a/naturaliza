        "operationId": "updateProductoData",
        "requestBody": {
          "description": "Update an existent product in the store",
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "characteristics": {
                    "type": "object",
                    "properties": {
                      "origin": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "flavor": {
                        "type": "string"
                      },
                      "properties": {
                        "type": "string"
                      },
                      "caffeineContent": {
                        "type": "string"
                      },
                      "allergens": {
                        "type": "string"
                      },
                      "organicCertification": {
                        "type": "boolean"
                      }
                    }
                  },
                  "ingredients": {
                    "type": "string"
                  },
                  "presentations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "size": {
                          "type": "string"
                        },
                        "price": {
                          "type": "number",
                          "format": "float"
                        },
                        "stock": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "preparationInstructions": {
                    "type": "object",
                    "properties": {
                      "recommendedPortion": {
                        "type": "string"
                      },
                      "waterTemperature": {
                        "type": "string"
                      },
                      "infusionTime": {
                        "type": "string"
                      },
                      "aditionalInfo": {
                        "type": "string"
                      }
                    }
                  }
                },
                "encoding": {
                  "image": {
                    "contentType": "image/*"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Product with code: ${product.code} updated"
          },
          "404": {
            "description": "Product not found with code:"
          },
          "500": {
            "description": "Error updateProduct:"
          }
        },
        "security": [
          {
            "user_auth_Sales": ["token Beaner"]
          }
        ]
      }
    },
    "/products/deleteProduct/{code}": {
      "delete": {
        "tags": ["Products"],
        "summary": "Delete product by Code",
        "description": "For valid response try code with value only string. nonstring will generate API errors",
        "operationId": "deleteProductByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "description": "Code of the product that needs to be deleted",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product Delete"
          },
          "404": {
            "description": "Product not found with code: {code}"
          },
          "500": {
            "description": "Error destroyProduct:"
          }
        },
        "security": [
          {
            "user_auth_Sales": ["token Beaner"]
          }
        ]
      }
    },
    "/api/users/{email}": {
      "get": {
        "tags": ["Users"],
        "summary": "Find User by email",
        "description": "Returns a single user",
        "operationId": "getUserByEmail",
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "description": "Email of user to return",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Error finding user by email:"
          }
        }
