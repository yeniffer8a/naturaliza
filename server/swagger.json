{
  "openapi": "3.0.0",
  "info": {
    "title": "Naturaliza Api",
    "description": "this is api for a Ecommerse, that products are diferents types of mixed of teas",
    "contact": {
      "name": "Luis Lozano"
    },
    "version": "1.0.1"
  },
  "servers": [
    {
      "url": "http://localhost:3000/"
    }
  ],
  "tags": [
    {
      "name": "Users",
      "description": "Info about clients o admin"
    },
    {
      "name": "Products",
      "description": "All about of items that we can to sell"
    },
    {
      "name": "PurchaseOrder",
      "description": "register of all order of products"
    }
  ],
  "paths": {
    "/products/listproducts": {
      "get": {
        "tags": ["Products"],
        "summary": "Return all products not deleted",
        "description": "Present in Json format all products active in the database",
        "operationId": "listproducts",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Products"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/products/oneproduct/{code}": {
      "get": {
        "tags": ["Products"],
        "summary": "Find product by Code",
        "description": "For valid response try string Code",
        "operationId": "oneProduct",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "description": "Code of product that needs to be review",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/Products"
                }
              }
            }
          },
          "404": {
            "description": "Product not found with code: ???"
          },
          "500": {
            "description": "Error getProductByCode"
          }
        }
      }
    },
    "/products/productsbyname/{name}": {
      "get": {
        "tags": ["Products"],
        "summary": "Find products that containt the word pass in its name",
        "description": "For valid response for a correct string",
        "operationId": "productByName",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "word that need to look for in the name of the products",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Products"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Product not found with name: ???"
          },
          "500": {
            "description": "Error getProductsByname"
          }
        }
      }
    },
    "/products/filter": {
      "get": {
        "tags": ["Products"],
        "summary": "Find products that containt the characteristics pass",
        "description": "For valid response for a correct characteristics",
        "operationId": "productByCharacteristics",
        "parameters": [
          {
            "name": "characteristics",
            "in": "query",
            "description": "characteristics that need to look for in the characteristics of the products",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "origin": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "flavor": {
                  "type": "string"
                },
                "properties": {
                  "type": "string"
                },
                "caffeineContent": {
                  "type": "string"
                },
                "allergens": {
                  "type": "string"
                },
                "organicCertification": {
                  "type": "boolean"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Products"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Debe proporcionar al menos una característica."
          },
          "404": {
            "description": "No se encontraron productos con esas características."
          },
          "500": {
            "description": "Error getProductsByCharacteristics:"
          }
        }
      }
    },
    "/products/createProduct": {
      "post": {
        "tags": ["Products"],
        "summary": "Create a new product",
        "description": "Place a new product in the store",
        "operationId": "createNewProduct",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "characteristics": {
                    "type": "object",
                    "properties": {
                      "origin": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "flavor": {
                        "type": "string"
                      },
                      "properties": {
                        "type": "string"
                      },
                      "caffeineContent": {
                        "type": "string"
                      },
                      "allergens": {
                        "type": "string"
                      },
                      "organicCertification": {
                        "type": "boolean"
                      }
                    }
                  },
                  "ingredients": {
                    "type": "string"
                  },
                  "presentations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "size": {
                          "type": "string"
                        },
                        "price": {
                          "type": "number",
                          "format": "float"
                        },
                        "stock": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "preparationInstructions": {
                    "type": "object",
                    "properties": {
                      "recommendedPortion": {
                        "type": "string"
                      },
                      "waterTemperature": {
                        "type": "string"
                      },
                      "infusionTime": {
                        "type": "string"
                      },
                      "aditionalInfo": {
                        "type": "string"
                      }
                    }
                  }
                },
                "encoding": {
                  "image": {
                    "contentType": "image/*"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Products"
                }
              }
            }
          },
          "400": {
            "description": "Errors in the validation of the data with zod"
          },
          "500": {
            "description": "Error createProduct:"
          }
        },
        "security": [
          {
            "user_auth_Sales": ["token Beaner"]
          }
        ]
      }
    },
    "/products/updateProduct": {
      "patch": {
        "tags": ["Products"],
        "summary": "Update an existing product",
