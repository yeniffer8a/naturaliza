        "description": "Delete purchase order by orderNumber Soft",
        "operationId": "deleteOrderByNumber",
        "parameters": [
          {
            "name": "orderNumber",
            "in": "path",
            "description": "order Number of the order that needs to be deleted",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Purchase Order deleted"
          },
          "500": {
            "description": "Error destroyOrder:"
          }
        },
        "security": [
          {
            "user_auth_Sales": ["token Beaner"]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Products": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "ADB145D"
          },
          "name": {
            "type": "string",
            "example": "Infusion de te verde"
          },
          "description": {
            "type": "string",
            "example": "Te traido de la india mezclado con variades del mismo"
          },
          "image": {
            "type": "string",
            "description": "url of the image in the bucket",
            "example": "https://xdcrhbhtzfatlmeoejjo.supabase.co/storage/v1/object/public/imagens/imagen/1739055989514_Rectangle_49.png"
          },
          "characteristics": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "example": "India"
              },
              "type": {
                "type": "string",
                "example": "Te verde"
              },
              "flavor": {
                "type": "string",
                "example": "Picante"
              },
              "properties": {
                "type": "string",
                "example": "Digestivo"
              },
              "caffeineContent": {
                "type": "string",
                "example": "Bajo contenido"
              },
              "allergens": {
                "type": "string",
                "example": "Sin Gluten"
              },
              "organicCertification": {
                "type": "boolean",
                "example": true
              }
            }
          },
          "ingredients": {
            "type": "string",
            "example": "Te verde, jengibre"
          },
          "presentations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "string",
                  "example": "Bolsa 50gr"
                },
                "price": {
                  "type": "number",
                  "format": "float",
                  "example": 15.23
                },
                "stock": {
                  "type": "integer",
                  "example": 125
                }
              }
            }
          },
          "preparationInstructions": {
            "type": "object",
            "properties": {
              "recommendedPortion": {
                "type": "string",
                "example": "30 gr"
              },
              "waterTemperature": {
                "type": "string",
                "example": "30 °C"
              },
              "infusionTime": {
                "type": "string",
                "example": "3 - 10 min"
              },
              "aditionalInfo": {
                "type": "string",
                "example": "Excelente Sabor"
              }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "example": "James"
          },
          "email": {
            "type": "string",
            "example": "john@email.com"
          },
          "address": {
            "type": "string",
            "example": "cl 20 50 - 45"
          },
          "country": {
            "type": "string",
            "example": "Colombia"
          },
          "city": {
            "type": "string",
            "example": "Bogota"
          },
          "postCode": {
            "type": "string",
            "example": "12345"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Alto1542*"
          },
          "role": {
            "type": "string",
            "description": "rol of the user",
            "example": "client",
            "enum": ["client", "salesforce", "guest"]
          },
          "registered": {
            "type": "boolean"
          }
        }
      },
      "PurchaseOrder": {
        "type": "object",
        "properties": {
          "orderNumber": {
            "type": "integer",
            "format": "int64",
            "example": 100000000000
          },
          "user": {
            "type": "object",
            "properties": {
              "idUser": {
                "type": "string",
                "description": "Is a Type.ObjectId of mongoDB, can be null",
                "example": "67a6a60a63070bfe2a88b8a9"
              },
              "firstName": {
                "type": "string",
                "example": "James"
              },
              "lastName": {
                "type": "string",
                "example": "Perez"
              },
              "email": {
                "type": "string",
                "example": "john@email.com"
              },
              "address": {
                "type": "string",
                "example": "cl 20 50 - 45"
              },
              "city": {
                "type": "string",
                "example": "Bogota"
              },
              "country": {
                "type": "string",
                "example": "Colombia"
              },
              "postCode": {
                "type": "string",
                "example": "12345"
              }
            }
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product": {
                  "type": "string",
                  "description": "Is a Type.ObjectId of mongoDB, can not be null",
                  "example": "67a6a60a63070bfe2a88b8a9"
                },
                "quantity": {
                  "type": "integer",
                  "format": "int32",
                  "example": 10
                }
              }
            }
          },
          "sameAddress": {
            "type": "boolean",
            "example": true
          },
          "billingAddress": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string",
                "example": "cl 20 50 - 45"
              },
              "city": {
                "type": "string",
                "example": "Bogota"
              },
              "country": {
                "type": "string",
                "example": "Colombia"
              },
              "postCode": {
                "type": "string",
                "example": "12345"
              }
            }
          },
          "cost": {
            "type": "object",
            "properties": {
              "subTotal": {
                "type": "number",
                "format": "float",
                "example": 15.23
              },
              "delivery": {
                "type": "number",
                "format": "float",
                "example": 1.5
              },
              "total": {
                "type": "number",
                "format": "float",
                "example": 16.73
              }
            }
          },
          "status": {
            "type": "string",
            "description": "Status of the order",
            "example": "pending",
            "enum": ["pending", "paid", "shipped", "delivered"]
          },
          "paymentInfo": {
            "type": "object",
            "properties": {
              "paymentMethod": {
                "type": "string",
                "example": "credit card"
              },
              "paymentStatus": {
                "type": "string",
                "example": "accept"
              },
              "paymentDate": {
                "type": "string",
                "format": "date-time",
                "example": "2025-02-08T00:32:10.512+00:00"
              },
              "paymentMethodNumber": {
                "type": "integer",
                "format": "int64",
                "example": "54178956478964"
              }
            }
          },
          "deliveryTime": {
            "type": "string",
            "format": "date-time",
            "example": "2025-02-08T00:32:10.512+00:00"
          }
        }
      }
    },
    "securitySchemes": {
      "user_auth": {
        "type": "http",
