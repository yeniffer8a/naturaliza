    "/api/token": {
      "post": {
        "tags": ["Users"],
        "summary": "login a existing user  to the store",
        "description": "login a existing User to the store",
        "operationId": "login",
        "requestBody": {
          "description": "login a existing user in the store",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "john@email.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "Alto1542*"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Email and password are required"
          },
          "404": {
            "description": "User not found or deleted"
          },
          "401": {
            "description": "Passwords do not match"
          },
          "500": {
            "description": "Unexpected error occurred"
          }
        }
      }
    },
    "/purchaseOrder/listPurchase": {
      "get": {
        "tags": ["PurchaseOrder"],
        "summary": "Return all Purchase Orders not deleted",
        "description": "Present in Json format all purchase order active in the database",
        "operationId": "listPurchase",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PurchaseOrder"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/purchaseOrder/createorder": {
      "post": {
        "tags": ["PurchaseOrder"],
        "summary": "Place an order for a store",
        "description": "Place a new order in the store",
        "operationId": "createNewPurchaseOrder",
        "requestBody": {
          "description": "OrderNumber is generated by backend in automent form ",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseOrder"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "":{
                      "$ref": "#/components/schemas/PurchaseOrder"
                    }
                    
                  }
                }
              }
