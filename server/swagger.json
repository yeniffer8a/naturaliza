          "400": {
            "description": "Errors in the validation of the data with zod"
          },
          "500": {
            "description": "Error service"
          }
        }
      }
    },
    "purchaseOrder/updatestatus": {
      "patch": {
        "tags": ["PurchaseOrder"],
        "summary": "Update status an order for a store",
        "description": "Update status an order in the store, when this order advance in the processes",
        "operationId": "updateStatus",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type":"object",
                "properties":{
                  "orderNumber":{
                    "type":"integer",
                    "format":"int64",
                    "example":100000000000
                  },
                  "status":{
                    "type":"string",
                    "example":"paid"
                  }

                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "message":{
                      "type":"string",
                      "example":"Purchase Order with number order: ${order.orderNumber} status updated"}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Error getPurchaseOrderByNumber: ${error.message}"
          },
          "500": {
            "description": "Error updateStatusOrder: ${order.orderNumber}"
          }
        }
      }
    },
    "/purchaseOrder/deleteorder/{orderNumber}":{
      "delete": {
        "tags": ["PurchaseOrder"],
